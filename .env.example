# Copy to .env.local and fill in fairview-dev values only.
# Never put fairview-staging keys on this machine (see PHASE-1-SPEC.md, ENVIRONMENTS).
# Never prefix a secret with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
# Supabase personal access token, for deploying Edge Functions from this machine only.
SUPABASE_ACCESS_TOKEN=
# Provider secrets (Plaid, Argyle, AWS) are NOT set here: they live only in Supabase Edge Function secrets.
