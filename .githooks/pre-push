#!/usr/bin/env bash
# PUSH-CHECKLIST.md: scan every line added by the commits being pushed that no remote has yet.
# Enable once per clone with: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # a branch deletion pushes nothing
  bash "$root/scripts/push-check.sh" --history "$local_sha" --not --remotes || status=1
done
exit $status
